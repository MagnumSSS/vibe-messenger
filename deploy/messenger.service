# Phase 7.5a — systemd-юнит ВайбБункера (Debian 12, пользователь vibebunker)
#
# Установка:
#   sudo cp deploy/messenger.service /etc/systemd/system/messenger.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now messenger
#   systemctl status messenger --no-pager
#
# EnvironmentFile — тот же .env, что читает приложение (scripts/load_env.py).
# Формат KEY=VALUE совпадает, поэтому файл один и дублировать секреты не нужно.
# Значения в .env НЕ берите в кавычки: systemd оставит кавычки внутри значения.

[Unit]
Description=VibeBunker private messenger (FastAPI/uvicorn)
Documentation=https://github.com/MagnumSSS/vibe-messenger
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vibebunker
Group=vibebunker
WorkingDirectory=/home/vibebunker/vibe_mes
EnvironmentFile=/home/vibebunker/vibe_mes/.env
# Слушаем ТОЛЬКО локалхост: наружу пускает nginx (443 → 127.0.0.1:8000)
ExecStart=/home/vibebunker/vibe_mes/.venv/bin/uvicorn main:app --host 127.0.0.1 --port ${PORT} --proxy-headers --forwarded-allow-ips 127.0.0.1
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=2
TimeoutStopSec=20
KillSignal=SIGINT

StandardOutput=journal
StandardError=journal
SyslogIdentifier=messenger

# --- лёгкая изоляция (SQLite и логи лежат в data/, он в ReadWritePaths) ---
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/vibebunker/vibe_mes/data /home/vibebunker/backups
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
