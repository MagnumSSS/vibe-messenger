# ============================================================================
# Phase 7.5a — ПРОД-конфигурация ВайбБункера (vibebunker.ru, Debian 12 VPS)
#
#   cp .env.prod.example .env
#   chmod 600 .env           # в файле секреты — читать должен только vibebunker
#   nano .env                # заполнить SECRET_KEY и (позже) SMTP_*
#
# Этот же файл подхватывают двое:
#   * приложение  — scripts/load_env.py при старте;
#   * systemd     — EnvironmentFile= в deploy/messenger.service.
# Поэтому: НЕ берите значения в кавычки и не пишите пробелы вокруг «=».
# ============================================================================

# Режим. prod = строгий: SECRET_KEY < 32 символов → старт запрещён (exit 1),
# debug-трассировки выключены, генератор ошибок недоступен, коды без SMTP → 503.
APP_MODE=prod

# Ключ подписи сессий. ОБЯЗАТЕЛЕН, минимум 32 символа.
# Сгенерировать прямо на сервере:
#   python3 -c "import secrets;print(secrets.token_hex(32))"
# Смена ключа разлогинивает всех — это нормально и делается осознанно.
SECRET_KEY=

# Порт uvicorn. Наружу НЕ торчит: слушаем 127.0.0.1, снаружи только nginx 443.
PORT=8000

# Каталог данных: messenger.db (WAL), вложения, data/logs/{app,error}.log
DATA_DIR=/home/vibebunker/vibe_mes/data

# Бэкапы (scripts/backup.py, cron из шага 10 runbook'а) + метрика last_backup_at в пульсе
BACKUP_DIR=/home/vibebunker/backups
DB_NAME=messenger.db
RETAIN_COUNT=5

# Ветка для scripts/update.sh (PRE-CHECK → backup → fetch → restart → POST-CHECK)
UPDATE_BRANCH=main

# Максимальный размер вложения, байт (5 МБ). У nginx стоит client_max_body_size 6m.
MAX_UPLOAD_BYTES=5242880

# Первый зарегистрированный получает админа (шаг 9 runbook'а: зарегистрируйся первым!)
FIRST_USER_ADMIN=1

# ---- Сессии и заголовки (за nginx + HTTPS) --------------------------------
# lax достаточно: приложение открывается по своему домену, не в чужом iframe.
SESSION_SAME_SITE=lax
# 1 — cookie только по HTTPS. Ставить ПОСЛЕ выпуска сертификата (шаг 8);
# если включить раньше, вход по http работать не будет.
SESSION_SECURE=1
# deny — запрет встраивания в iframe (кликджекинг)
FRAME_OPTIONS=deny

# ---- Почта (коды подтверждения, R7) ---------------------------------------
# Пока SMTP_HOST пуст, в APP_MODE=prod эндпоинты кодов отвечают 503
# («почта не настроена») — это ожидаемо до получения доступов SMTP.
# Заполнить, когда придут реквизиты, затем: sudo systemctl restart messenger
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@vibebunker.ru
SMTP_STARTTLS=yes
