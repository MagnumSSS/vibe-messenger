# SECRET_KEY is REQUIRED in production - generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-in-production

# Set to 1 ONLY for initial setup on fresh install, then set to 0 or remove
FIRST_USER_ADMIN=0

# Maximum file upload size in bytes (default: 10MB)
MAX_UPLOAD_BYTES=10485760

# Server port
PORT=8000

# Directory for database and uploads
DATA_DIR=/var/lib/messenger/data

# Directory for backups
BACKUP_DIR=/var/lib/messenger/backups
