# Пример конфигурации. Скопируй в .env и поправь под себя:
#   cp .env.example .env
#
# .env читается scripts/load_env.py при старте приложения.
# УЖЕ заданные переменные окружения файл НЕ перезаписывает:
# запуск вида `SECRET_KEY=... python main.py` всегда важнее .env.

# Режим: dev | prod
#   dev  — разрешает слабый/отсутствующий SECRET_KEY (пишет warning в app.log)
#   prod — требует SECRET_KEY >= 32 символов, иначе старт падает с exit 1
APP_MODE=dev

# Ключ подписи сессий. В прода — обязателен, минимум 32 символа.
# Сгенерировать: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# Порт приложения
PORT=8000

# Максимальный размер вложения, байт (5 МБ)
MAX_UPLOAD_BYTES=5242880

# Куда складывать бэкапы (используется scripts/backup.py и метрикой last_backup_at в пульсе)
BACKUP_DIR=

# Сколько последних копий хранить
RETAIN_COUNT=5

# Ветка, на которую обновляется scripts/update.sh (по умолчанию — текущая)
UPDATE_BRANCH=main

# ---- Почта (коды подтверждения, фаза R7) ----
# Без SMTP_HOST письма не уходят: в dev код виден в data/logs/app.log
# (строка «EMAIL CODE user_id=… purpose=… code=NNNNNN»), в prod эндпоинты кодов → 503.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_STARTTLS=yes

# ---- ниже — необязательные, раскомментируй при необходимости ----

# Каталог данных: БД, вложения, логи. По умолчанию ./data
# DATA_DIR=./data

# Первый зарегистрированный пользователь становится админом (1 — да)
# FIRST_USER_ADMIN=1

# Формат cookie сессии для работы внутри iframe на другом домене:
# SESSION_SAME_SITE=none
# SESSION_SECURE=1
# FRAME_OPTIONS=none
